 / patched: reference → faithful target&#10;Regenerated: reference purpose → new interface&#10;Record the evaluated image extents" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#18314D;fontFamily=Arial;fontSize=22;spacing=14;rounded=0;align=left;fontColor=#18314D;spacing=0;" vertex="1" parent="1"><mxGeometry x="42" y="805.0" width="550" height="85" as="geometry" /></mxCell><mxCell id="roles" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#B6C7D8;strokeWidth=1.5;fontColor=#18314D;fontFamily=Arial;fontSize=20;spacing=14;" vertex="1" parent="1"><mxGeometry x="20" y="940.0" width="1280" height="110" as="geometry" /></mxCell><mxCell id="roles1" value="Five typed judgments + deterministic response validation" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#18314D;fontFamily=Arial;fontSize=25;spacing=14;rounded=0;align=left;fontColor=#18314D;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="954.0" width="760" height="30" as="geometry" /></mxCell><mxCell id="roles2" value="Controller validates the evidence and applies the contract." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#18314D;fontFamily=Arial;fontSize=22;spacing=14;rounded=0;align=left;fontColor=#62758B;spacing=0;" vertex="1" parent="1"><mxGeometry x="42" y="999.0" width="760" height="29" as="geometry" /></mxCell><mxCell id="decisions" value="Admit / Do not admit&#10;Findings and evidence retained" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#18314D;fontFamily=Arial;fontSize=23;spacing=14;rounded=0;align=left;fontColor=#3E82B5;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="856" y="963.0" width="420" height="60" as="geometry" /></mxCell><mxCell id="pointer-1" value="" edge="1" parent="1" style